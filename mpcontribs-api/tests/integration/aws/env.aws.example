# AWS wiring for the local MiniStack stack (tests/integration/aws/docker-compose.yaml).
# Copy to .env.aws (gitignored) or merge into your project .env.
#
# Load just for a run:  set -a; source tests/integration/aws/.env.aws; set +a
# Then start the app as usual; its S3/SQS clients will hit MiniStack, not real AWS.

# Point S3 + SQS clients at the local edge endpoint (empty string = real AWS).
MPCONTRIBS_AWS__ENDPOINT_URL=http://localhost:4566
MPCONTRIBS_AWS__REGION=us-east-1

# Queue URLs. MiniStack's default account id is 000000000000 and it advertises
# MINISTACK_HOST (localhost) in returned endpoints, so queue URLs take this path form.
MPCONTRIBS_AWS__SQS__DOWNLOAD_QUEUE_URL=http://localhost:4566/000000000000/mpcontribs-download
MPCONTRIBS_AWS__SQS__TRANSFORM_QUEUE_URL=http://localhost:4566/000000000000/mpcontribs-transform
MPCONTRIBS_AWS__SQS__PROJECTION_QUEUE_URL=http://localhost:4566/000000000000/mpcontribs-projection

# Dummy credentials: boto refuses to sign requests without them; MiniStack ignores the values.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
