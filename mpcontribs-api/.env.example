MPCONTRIBS_ENVIRONMENT=dev
MPCONTRIBS_VERSION=0.0.0-dev
MPCONTRIBS_AUTHZ__DOMAIN=mpcontribs

# --- MongoDB (dev) ---
MPCONTRIBS_MONGO__URI=mongodb+srv://<db_username>:<db_password>@host.hash.mongodb.net/?appName=database-name
MPCONTRIBS_MONGO__DB_NAME=database-name

# --- AWS ---
# Credentials use the ambient AWS chain (NOT MPCONTRIBS_*): set these, or use AWS_PROFILE=<dev>.
AWS_ACCESS_KEY_ID=<Access Key ID>
AWS_SECRET_ACCESS_KEY=<Secret Access Key>
# Required for downloads to enqueue (no default):
MPCONTRIBS_AWS__SQS__DOWNLOAD_QUEUE_URL=<SQS queue url for downloads>
# Optional overrides
# MPCONTRIBS_AWS__REGION=us-east-1
# MPCONTRIBS_AWS__S3__DOWNLOADS_BUCKET=mpcontribs-downloads
# LocalStack only; leave unset for prod AWS:
# MPCONTRIBS_AWS__ENDPOINT_URL=http://localhost:4566

# --- Redis (required to start; not exercised yet) ---
MPCONTRIBS_REDIS__ADDRESS=redis://localhost:6379
MPCONTRIBS_REDIS__URL=redis://localhost:6379/0

# --- Mail (required to start; not exercised yet) ---
MPCONTRIBS_MAIL_DEFAULT_SENDER=contribs@materialsproject.org

# --- Telemetry off locally (defaults on) ---
MPCONTRIBS_OTEL__ENABLED=false
